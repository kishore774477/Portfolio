# Copy to .env and fill in to enable real email delivery.
# Without these set, the API still works: submissions are stored in contact.db
# but no email is sent.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-gmail-app-password
CONTACT_TO_EMAIL=kishore774477@gmail.com

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=https://kishore774477.github.io,http://localhost:5500

DATABASE_URL=sqlite:///./contact.db
